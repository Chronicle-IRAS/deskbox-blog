---
interface Props { eyebrow: string; title: string; lead?: string; count?: number; countLabel?: string }
const { eyebrow, title, lead, count, countLabel = '篇' } = Astro.props;
---
<header class="ph wrap">
  <div class="ph__top rise">
    <p class="kicker">{eyebrow}</p>
    {count !== undefined && <p class="ph__count mono"><span data-filter-count>{count}</span> {countLabel}</p>}
  </div>
  <h1 class="ph__title display rise" style="--i:1">{title}</h1>
  {lead && <p class="ph__lead rise" style="--i:2">{lead}</p>}
  <slot />
</header>
<style>
  .ph {
    padding-top: clamp(16px, 4vw, 40px);
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .ph__top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--ink);
  }
  .ph__count {
    font-size: 12px;
    color: var(--ink-2);
  }
  .ph__title {
    margin-top: clamp(18px, 3vw, 30px);
    font-size: clamp(46px, 8vw, 104px);
    letter-spacing: -0.035em;
    line-height: 1;
  }
  .ph__lead {
    max-width: 34em;
    margin: 20px 0 0 clamp(0px, 16vw, 220px);
    font-size: clamp(16px, 1.3vw, 18px);
    line-height: 1.85;
    color: var(--ink-2);
  }
</style>
