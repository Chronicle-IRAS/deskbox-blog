---
import type { PostSummary } from '../lib/posts';

interface Props {
  name: string;
  order: number;
  posts: PostSummary[];
  currentSlug: string;
}

const { name, order, posts, currentSlug } = Astro.props;
---

{posts.length >= 2 && (
  <aside class="series-nav" aria-labelledby="series-title" data-pagefind-ignore>
    <header class="series-nav__header">
      <div>
        <p class="series-nav__eyebrow">系列</p>
        <h2 id="series-title">{name}</h2>
      </div>
      <p class="series-nav__progress">第 {order} / {posts.length} 篇</p>
    </header>

    <ol class="series-nav__list">
      {posts.map((post, index) => (
        <li class="series-nav__item">
          {post.slug === currentSlug ? (
            <span class="series-nav__link" aria-current="page">
              <span class="series-nav__index">{String(index + 1).padStart(2, '0')}</span>
              <span>{post.title}</span>
            </span>
          ) : (
            <a class="series-nav__link" href={`/blog/${post.slug}/`}>
              <span class="series-nav__index">{String(index + 1).padStart(2, '0')}</span>
              <span>{post.title}</span>
            </a>
          )}
        </li>
      ))}
    </ol>
  </aside>
)}

<style>
  .series-nav {
    margin-block-start: var(--space-8);
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface);
  }

  .series-nav__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block-end: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .series-nav__eyebrow {
    margin: 0 0 var(--space-1);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .series-nav__header h2 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: 1.3;
  }

  .series-nav__progress {
    margin: 0;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .series-nav__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .series-nav__item + .series-nav__item {
    border-top: 1px solid var(--border);
  }

  .series-nav__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-height: 44px;
    padding-block: var(--space-2);
    color: var(--fg-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .series-nav__link:hover {
    color: var(--accent);
  }

  .series-nav__link:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .series-nav__link[aria-current="page"] {
    color: var(--fg);
    font-weight: 600;
  }

  .series-nav__index {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .series-nav__link {
      transition: none;
    }
  }
</style>
