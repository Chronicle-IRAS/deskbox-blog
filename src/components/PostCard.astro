---
import type { PostSummary } from '../lib/posts';
import { dayKey, formatDate } from '../lib/format';
import { tagSlugByName } from '../data/tags';

interface Props {
  post: PostSummary;
  variant?: 'default' | 'featured';
}

const { post, variant = 'default' } = Astro.props;
const href = `/blog/${post.slug}/`;
const datetime = dayKey(post.pubDate);
---

<article class:list={['post-card', `post-card--${variant}`]}>
  <time class="post-date" datetime={datetime}>{formatDate(post.pubDate)}</time>

  <div class="post-body">
    <a class="post-title" href={href}>{post.title}</a>
    <p class="post-description">{post.description}</p>
    <div class="post-meta">
      {
        post.tags.length > 0 && (
          <ul class="post-tags">
            {post.tags.map((tag) => (
              <li class="post-tag">
                <a href={`/tags/${tagSlugByName(tag)}/`}>#{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
      <span class="post-reading">约 {post.readingMinutes} 分钟</span>
    </div>
  </div>
</article>

<style>
  .post-card {
    min-width: 0;
  }

  .post-date {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .post-body {
    min-width: 0;
  }

  .post-title {
    display: block;
    color: var(--fg);
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: var(--leading-lg);
    text-decoration: none;
    text-wrap: balance;
    overflow-wrap: anywhere;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .post-title:hover {
    color: var(--accent);
  }

  .post-description {
    display: -webkit-box;
    margin-top: var(--space-2);
    overflow: hidden;
    color: var(--fg-muted);
    font-size: var(--text-base);
    line-height: 1.65;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-3);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .post-tag {
    display: inline-flex;
    align-items: center;
    padding: 3px 10px;
    color: var(--fg-muted);
    font-size: var(--text-xs);
    line-height: var(--leading-xs);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .post-tag:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .post-tag a {
    display: inline-flex;
    align-items: center;
    color: inherit;
    text-decoration: none;
  }

  .post-reading {
    color: var(--fg-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  /* Default: quiet editorial list row. */
  .post-card--default {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: 1px solid var(--border);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .post-card--default .post-date {
    padding-top: 0.2rem;
  }

  .post-card--default:hover {
    background: var(--surface-muted);
    border-bottom-color: var(--border-strong);
  }

  /* Featured: latest post block with stronger boundary and display serif title. */
  .post-card--featured {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent);
    border-radius: var(--radius-md);
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .post-card--featured:hover {
    border-color: var(--border-strong);
    border-top-color: var(--accent);
  }

  .post-card--featured .post-title {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.2rem + 0.5vw, 1.625rem);
    line-height: 1.3;
  }

  @media (max-width: 639px) {
    .post-card--default {
      grid-template-columns: 1fr;
      gap: var(--space-2);
    }

    .post-card--default .post-date {
      padding-top: 0;
    }

    .post-card--featured {
      padding: var(--space-5);
    }

    .post-tag {
      display: inline-flex;
      align-items: center;
      padding: 0;
    }

    .post-tag a {
      min-height: 44px;
      padding-inline: 10px;
    }
  }
</style>
