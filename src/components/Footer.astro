---
import { site } from '../config';
import { url } from '../lib/url';
import Icon from './Icon.astro';
const yearNow = new Date().getFullYear();
---
<footer class="foot">
  <div class="wrap">
    <div class="foot__grid">
      <p class="foot__say display">写代码，<br /><span class="marker">也写生活。</span></p>
      <div class="foot__col">
        <p class="kicker">在别处</p>
        <ul>
          {site.social.map((s) => (
            <li><a class="link-arrow" href={url(s.href)}><Icon name={s.icon} size={15} /><span>{s.label}</span></a></li>
          ))}
        </ul>
      </div>
      <div class="foot__col">
        <p class="kicker">本站</p>
        <ul>
          <li><a class="link-arrow" href={url('/archive/')}>归档</a></li>
          <li><a class="link-arrow" href={url('/privacy/')}>隐私</a></li>
          <li><a class="link-arrow" href={url('/sitemap-index.xml')}>Sitemap</a></li>
        </ul>
      </div>
    </div>
    <a class="foot__word" href={url('/')} aria-label="DeskBox 回到首页">
      {'DeskBox'.split('').map((c, i) => <span style={`--i:${i}`}>{c}</span>)}<span class="foot__dot">.</span>
    </a>
    <div class="foot__base">
      <span>© {yearNow} {site.name}</span>
      <span>Astro 构建 · 字体自托管 · 不追踪</span>
    </div>
  </div>
</footer>

<style>
  .foot {
    margin-top: clamp(80px, 12vw, 150px);
    border-top: 2px solid var(--ink);
    padding: clamp(36px, 5vw, 60px) 0 calc(24px + env(safe-area-inset-bottom));
    overflow: hidden;
    /* 首屏外不参与布局，长文章的首次 layout 更轻 */
    content-visibility: auto;
    contain-intrinsic-size: auto 760px;
  }
  .foot__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 32px;
  }
  .foot__say {
    font-size: clamp(30px, 3.6vw, 46px);
    line-height: 1.15;
  }
  .foot__col ul {
    list-style: none;
    padding: 0;
    margin-top: 12px;
    display: grid;
    gap: 8px;
  }
  .foot__col a {
    font-size: 15px;
    font-weight: 500;
  }
  .foot__word {
    display: flex;
    align-items: baseline;
    margin: clamp(32px, 6vw, 72px) 0 clamp(14px, 2vw, 24px);
    font: 700 clamp(70px, 19vw, 280px) / 0.78 var(--f-display);
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.055em;
    color: var(--ink);
    user-select: none;
  }
  .foot__word span {
    display: inline-block;
    transition: transform 0.45s var(--spring), color 0.2s;
  }
  .foot__dot {
    color: var(--red);
  }
  /* 悬停时字母像被手指拨了一下，依次弹起 */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .foot__word:hover span {
      transform: translateY(-6%) rotate(calc((var(--i, 3) - 3) * 1.4deg));
      transition-delay: calc(var(--i, 0) * 25ms);
    }
  }
  .foot__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 18px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
    font-size: 13px;
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    .foot__grid {
      grid-template-columns: 1fr 1fr;
    }
    .foot__say {
      grid-column: 1 / -1;
    }
  }
</style>
