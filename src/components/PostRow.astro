---
import type { CardData } from '../lib/meta';
import { postUrl, tagUrl } from '../lib/url';
interface Props { p: CardData; index: number; total?: number }
const { p, index } = Astro.props;
const no = String(index + 1).padStart(2, '0');
---
<li class="row rise" style={`--i:${index % 8}`} data-item data-tags={p.tagSlugs.join('|')}>
  <a class="row__link" href={postUrl(p.slug)} data-row data-title={p.title} data-desc={p.description}
     data-cover={p.cover || undefined} data-meta={`${p.date} · ${p.minutes} 分钟`}>
    <span class="row__no" aria-hidden="true">{no}</span>
    <span class="row__main">
      <span class="row__title" style={`view-transition-name: t-${p.slug}`}><span class="row__hl">{p.title}</span></span>
      <span class="row__desc">{p.description}</span>
    </span>
    <span class="row__side mono">
      <time datetime={p.iso}>{p.date}</time>
      <span>{p.minutes} 分钟</span>
      {p.thumb && (
        <span class="row__thumb" aria-hidden="true">
          <img src={p.thumb} srcset={`${p.thumb} 168w, ${p.thumb2} 336w`} sizes="84px" width="168" height={p.thumbH} alt="" loading="lazy" decoding="async" />
        </span>
      )}
    </span>
  </a>
  {p.tags.length > 0 && (
    <span class="row__tags">
      {p.tags.map((t, i) => <a class="row__tag" href={tagUrl(p.tagSlugs[i])}>#{t}</a>)}
    </span>
  )}
</li>

<style>
  .row {
    position: relative;
    list-style: none;
    border-top: 1px solid var(--rule);
  }
  .row:last-child {
    border-bottom: 1px solid var(--rule);
  }
  .row__link {
    display: grid;
    grid-template-columns: 76px minmax(0, 1fr) 120px;
    align-items: start;
    gap: 0 24px;
    padding: 26px 0 56px;
  }
  /* 账本式的大号序号：衬线、斜体，像手写的页码 */
  .row__no {
    font: italic 500 44px/0.9 var(--f-display);
    font-variation-settings: 'opsz' 144;
    letter-spacing: -0.04em;
    color: var(--ink-4);
    transition: color 0.25s, transform 0.4s var(--spring);
  }
  .row__main {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .row__title {
    font: 600 clamp(19px, 1.9vw, 24px) / 1.4 var(--f-display);
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
  }
  /* 荧光笔划过标题 */
  .row__hl {
    background: linear-gradient(100deg, transparent 0.25em, var(--hi-soft) 0.35em, var(--hi-soft) calc(100% - 0.2em), transparent)
      0 88% / 0 0.58em no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-size 0.5s var(--ease);
  }
  .row__desc {
    font-size: 14.5px;
    color: var(--ink-2);
    line-height: 1.7;
    max-width: 58ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .row__side {
    display: grid;
    justify-items: end;
    gap: 2px;
    padding-top: 6px;
    font-size: 12px;
    color: var(--ink-3);
  }
  /* 有封面的文章：日期下面贴一张小照片 */
  .row__thumb {
    display: block;
    width: 92px;
    margin-top: 10px;
    padding: 4px;
    background: var(--sheet);
    border: 1px solid var(--rule-2);
    rotate: 2deg;
    box-shadow: 2px 2px 0 var(--paper-2);
    transition: rotate 0.3s var(--spring);
  }
  .row__thumb img {
    width: 100%;
    height: auto;
  }
  .row__link:hover .row__thumb {
    rotate: -1deg;
  }
  .row__side time {
    color: var(--ink-2);
  }
  .row__tags {
    position: absolute;
    left: 100px;
    bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
  }
  .row__tag {
    display: inline-block;
    padding: 3px 0;
    line-height: 20px;
    font-size: 13px;
    color: var(--red-ink);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }
  .row__tag:hover {
    text-decoration-color: currentColor;
  }
  @media (hover: hover) {
    .row__link:hover .row__hl {
      background-size: 100% 0.58em;
    }
    .row__link:hover .row__no {
      color: var(--red);
      transform: translateX(4px) rotate(-4deg);
    }
  }
  .row__link:focus-visible {
    outline-offset: -2px;
  }
  .row__link:focus-visible .row__hl {
    background-size: 100% 0.58em;
  }
  @media (max-width: 760px) {
    .row__link {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 6px 14px;
      padding: 22px 0 58px;
    }
    .row__no {
      font-size: 28px;
    }
    .row__side {
      grid-column: 2;
      grid-row: 1;
      display: flex;
      gap: 12px;
      justify-items: start;
      padding: 0;
    }
    .row__thumb {
      position: absolute;
      right: 0;
      bottom: 14px;
      width: 72px;
      margin: 0;
      padding: 3px;
    }
    .row__main {
      grid-column: 2;
    }
    .row__tags {
      left: 54px;
    }
  }
</style>
