---
/**
 * 正文插图（MDX 中使用）
 * <Figure src={img} alt="…" caption="…" />                       本地图片：avif + webp、响应式、模糊占位
 * <Figure src="https://…" width={1200} height={800} alt="…" />   外链图片：懒加载，需写宽高避免布局跳动
 * 可选：wide（比正文栏更宽）、invert（深色模式下反色，适合白底线稿）、placeholder="none"
 */
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import { blurDataURI } from '../lib/blur.mjs';

interface Props {
  src: ImageMetadata | string;
  alt: string;
  caption?: string;
  credit?: string;
  width?: number;
  height?: number;
  wide?: boolean;
  invert?: boolean;
  placeholder?: 'blur' | 'none';
  sizes?: string;
  loading?: 'lazy' | 'eager';
}
const { src, alt, caption, credit, width, height, wide = false, invert = false, placeholder = 'blur', loading = 'lazy' } = Astro.props;
const local = typeof src !== 'string';
const sizes = Astro.props.sizes ?? (wide ? '(min-width: 1100px) 960px, 100vw' : '(min-width: 780px) 700px, 100vw');
let full = '';
let ph = '';
if (local) {
  full = (await getImage({ src, width: Math.min(src.width, 2200), format: 'webp', quality: 85 })).src;
  if (placeholder === 'blur') ph = await blurDataURI((src as any).fsPath);
}
---
<figure class:list={['fig', { 'fig--wide': wide, 'fig--invert': invert }]}>
  <span class="fig__frame" data-ph={ph ? '' : undefined} style={ph ? `--ph:url(${ph})` : undefined}>
    {local ? (
      <Picture src={src} alt={alt} formats={['avif']} fallbackFormat="webp" widths={[...new Set([360, 540, 720, 1080, 1440].filter((w) => w < (src as ImageMetadata).width).concat(Math.min((src as ImageMetadata).width, 1600)))]} sizes={sizes} loading={loading} decoding="async" data-full={full} />
    ) : (
      <img src={src} alt={alt} width={width} height={height} loading={loading} decoding="async" referrerpolicy="no-referrer" data-external />
    )}
  </span>
  {(caption || credit) && (
    <figcaption>{caption}{credit && <span class="fig__credit">{credit}</span>}</figcaption>
  )}
</figure>
