---
import '../styles/admin-tokens.css';
import '../styles/admin-fonts.css';
import '../styles/admin-global.css';

interface Props {
  title: string;
  csrfToken: string;
  showLogout?: boolean;
}

const { title, csrfToken, showLogout = true } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · 管理 · Chronicle-IRAS的博客</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="admin-body">
    <header class="admin-header">
      <div class="container admin-header-inner">
        <a class="admin-brand" href="/admin/">Chronicle-IRAS的博客 管理</a>
        <nav class="admin-nav" aria-label="管理导航">
          <a href="/admin/tags/">标签</a>
          <a href="/admin/trash/">回收站</a>
          <a href="/" target="_blank" rel="noopener noreferrer">查看站点</a>
          {
            showLogout && (
              <form method="post" action="/api/admin/logout/">
                <input type="hidden" name="csrf" value={csrfToken} />
                <button class="admin-link-button" type="submit">退出</button>
              </form>
            )
          }
        </nav>
      </div>
    </header>

    <main class="container admin-main">
      <slot />
    </main>
    <script is:inline src="/scripts/admin-api.js" defer></script>
    <script is:inline src="/scripts/admin-editor.js" defer></script>
    <script is:inline src="/scripts/admin-trash.js" defer></script>
  </body>
</html>

<style>
  .admin-body {
    display: block;
    min-height: 100vh;
    background: var(--bg);
  }

  .admin-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .admin-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 64px;
  }

  .admin-brand {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    text-decoration: none;
  }

  .admin-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    font-size: var(--text-sm);
  }

  .admin-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--fg-muted);
    text-decoration: none;
  }

  .admin-nav a:hover {
    color: var(--fg);
  }

  .admin-nav form {
    margin: 0;
  }

  .admin-link-button {
    min-height: 44px;
    padding: 0;
    color: var(--fg-muted);
    font: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .admin-link-button:hover {
    color: var(--fg);
  }

  .admin-main {
    padding-block: var(--space-7) var(--space-9);
  }
</style>
