---
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getPublishedPosts } from '../lib/posts';

interface Props {
  title: string;
  description: string;
  activeNav?: 'home' | 'blog' | 'about';
  noindex?: boolean;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  keywords?: string[];
}

const {
  title,
  description,
  activeNav,
  noindex = false,
  image,
  type,
  publishedTime,
  modifiedTime,
  keywords,
} = Astro.props;

const pathname = Astro.url.pathname;
const isArticlePath = /^\/blog\/[^/]+\/$/.test(pathname);
const seoType = type ?? (isArticlePath ? 'article' : 'website');

let seoImage = image;
let seoPublishedTime = publishedTime;
let seoModifiedTime = modifiedTime;
let seoKeywords = keywords;

if (seoType === 'article' && (!seoPublishedTime || !seoKeywords)) {
  const slug = pathname.split('/')[2];
  const post = (await getPublishedPosts()).find((entry) => entry.data.slug === slug);

  if (post) {
    seoPublishedTime ??= post.data.pubDate.toISOString();
    seoModifiedTime ??= post.data.updatedDate?.toISOString();
    seoKeywords ??= post.data.tags;
    seoImage ??= post.data.cover?.src;
  }
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      image={seoImage}
      type={seoType}
      publishedTime={seoPublishedTime}
      modifiedTime={seoModifiedTime}
      keywords={seoKeywords}
      noindex={noindex}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/scripts/theme-init.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <SiteHeader activeNav={activeNav} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
