---
import { ClientRouter } from 'astro:transitions';
import { site } from '../config';
import { url } from '../lib/url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Search from '../components/Search.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  published?: Date;
  modified?: Date;
  tags?: string[];
  canonical?: string;
  jsonld?: Record<string, unknown>;
}
const { title, description = site.description, image = '/og/default.png', type = 'website', noindex = false, published, modified, tags = [], canonical, jsonld } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.description}`;
const canonicalURL = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(image), Astro.site).href;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const fontCss = `
@font-face{font-family:'Geist';src:url(${base}/fonts/geist.woff2) format('woff2');font-weight:300 700;font-display:swap}
@font-face{font-family:'Geist Mono';src:url(${base}/fonts/geist-mono.woff2) format('woff2');font-weight:400 600;font-display:swap}
@font-face{font-family:'Fraunces';src:url(${base}/fonts/fraunces.woff2) format('woff2');font-weight:300 700;font-display:swap;unicode-range:U+0000-024F,U+2000-206F,U+2190-21FF}
@font-face{font-family:'Fraunces';src:url(${base}/fonts/fraunces-italic.woff2) format('woff2');font-weight:300 700;font-style:italic;font-display:swap;unicode-range:U+0000-024F,U+2000-206F}
@font-face{font-family:'DeskBox Serif';src:url(${base}/fonts/display-sc.woff2) format('woff2');font-weight:600 900;font-display:swap}
`;
---
<!doctype html>
<html lang={site.lang} data-base={base}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#f4f1e9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171614" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={url('/favicon.ico')} sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={url('/rss.xml')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.name} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ?? site.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <link rel="preload" href={`${base}/fonts/geist.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/fraunces.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/display-sc.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/geist-mono.woff2`} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontCss} />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try { t = localStorage.getItem('db-theme'); } catch (e) {}
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        d.dataset.theme = t;
        try {
          var r = JSON.parse(localStorage.getItem('db-read') || '{}');
          if (r.size) d.dataset.readSize = r.size;
          if (r.font) d.dataset.readFont = r.font;
        } catch (e) {}
        document.addEventListener('astro:after-swap', function () {
          var n = document.documentElement;
          n.classList.add('js');
          n.dataset.theme = d.dataset.theme = (localStorage.getItem('db-theme') || d.dataset.theme);
          try {
            var r = JSON.parse(localStorage.getItem('db-read') || '{}');
            if (r.size) n.dataset.readSize = r.size;
            if (r.font) n.dataset.readFont = r.font;
          } catch (e) {}
        });
      })();
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip" href="#main">跳到正文</a>
    <div class="grain" aria-hidden="true"></div>
    <div class="loadbar" aria-hidden="true" transition:persist="loadbar"></div>
    <Nav />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <Search />
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
