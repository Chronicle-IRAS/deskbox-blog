---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Icon from '../components/Icon.astro';
import { getPosts, fmtDate } from '../lib/posts';
import { postUrl } from '../lib/url';
const posts = await getPosts();
---
<Base title="搜索" description="在 DeskBox 中搜索文章。" noindex>
  <PageHead eyebrow="检索" title="搜索" lead="在任意页面按 ⌘K（Windows 上是 Ctrl K）或 / 也能打开搜索。" />
  <div class="wrap s">
    <button class="s__box" type="button" data-search-open>
      <Icon name="search" size={20} /><span>想找点什么？</span><span class="s__keys" aria-hidden="true"><kbd class="key">⌘</kbd><kbd class="key">K</kbd></span>
    </button>
    <noscript>
      <ul class="s__list">{posts.map((p) => <li><a href={postUrl(p.data.slug)}>{p.data.title}</a> <span class="mono">{fmtDate(p.data.pubDate)}</span></li>)}</ul>
    </noscript>
  </div>
  <script>
    document.addEventListener('astro:page-load', () => {
      if (location.pathname.endsWith('/search/')) setTimeout(() => document.querySelector<HTMLElement>('.s__box')?.click(), 350);
    });
  </script>
</Base>
<style>
  .s__box {
    display: flex;
    align-items: center;
    gap: 14px;
    width: min(100%, 640px);
    height: 64px;
    padding: 0 14px 0 20px;
    border: 1.5px solid var(--ink);
    border-radius: 4px;
    background: var(--sheet);
    color: var(--ink-2);
    font-size: 17px;
    box-shadow: 5px 5px 0 var(--ink);
    transition: transform 0.1s, box-shadow 0.1s;
  }
  .s__box:active {
    transform: translate(5px, 5px);
    box-shadow: 0 0 0 var(--ink);
  }
  .s__keys {
    margin-left: auto;
    display: inline-flex;
    gap: 3px;
  }
  .s__list {
    margin-top: 24px;
  }
</style>
