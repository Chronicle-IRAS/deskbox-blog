---
import Base from '../layouts/Base.astro';
import PostRow from '../components/PostRow.astro';
import Preview from '../components/Preview.astro';
import Icon from '../components/Icon.astro';
import { getPosts, getStats, fmtDate } from '../lib/posts';
import { cardData } from '../lib/meta';
import { site, getTags } from '../config';
import { url, postUrl, tagUrl } from '../lib/url';
import { Image } from 'astro:assets';

const posts = await getPosts();
const tags = getTags();
const cards = await Promise.all(posts.map(cardData));
const stats = await getStats();
const [feat] = posts;
const featCard = cards[0];
const recent = cards.slice(1, 9);
const first = posts[posts.length - 1];
const tagCount = (n: string) => posts.filter((p) => (p.data.tags as string[]).includes(n)).length;
const seriesMap = new Map<string, typeof cards>();
cards.forEach((c) => c.series && seriesMap.set(c.series.name, [...(seriesMap.get(c.series.name) ?? []), c]));
const series = [...seriesMap.entries()].map(([name, list]) => ({ name, list: list.sort((a, b) => a.series!.order - b.series!.order) }));
---
<Base>
  <section class="mast wrap" aria-labelledby="hero-title">
    <p class="dateline rise">
      <span><span data-greet>你好</span>，此刻 <b class="num" data-clock>--:--</b></span>
      <span class="dateline__mid">已归档 {stats.posts} 篇 · 共 {stats.words.toLocaleString('zh-CN')} 字</span>
      <span>{first ? `始于 ${fmtDate(first.data.pubDate)}` : '等待第一篇文章'}</span>
    </p>

    <h1 id="hero-title" class="mast__title display">
      <span class="mast__l1 rise" style="--i:1">写代码，</span>
      <span class="mast__l2 rise" style="--i:2">也写<span class="mast__ink">生活<svg class="scribble" viewBox="0 0 300 24" preserveAspectRatio="none" aria-hidden="true"><path d="M3 15c40-8 80-10 122-6s92 7 135-1c14-3 26-4 37-2" /></svg></span>。</span>
    </h1>

    <div class="mast__aside rise" style="--i:3">
      <p class="mast__lead">{site.author.bio}做过的项目、技术上的判断，以及读书和生活里值得停一下的瞬间。<span class="marker">慢慢写，写清楚。</span></p>
      <div class="mast__cta">
        <a class="btn" href={url('/blog/')}>开始阅读 <Icon name="right" /></a>
        <button class="btn btn--paper" type="button" data-search-open><Icon name="search" /> 搜索 <span class="mast__keys" aria-hidden="true"><kbd class="key">⌘</kbd><kbd class="key">K</kbd></span></button>
      </div>
    </div>
  </section>

  {feat && (
    <section class="lead wrap" aria-labelledby="lead-title">
      <a class="lead__fig rise" href={postUrl(featCard.slug)} tabindex="-1" aria-hidden="true">
        <span class="lead__frame">
          {feat.runtime?.coverPath ? <img src={feat.runtime.coverPath} alt={feat.data.coverAlt ?? ''} /> : feat.data.cover ? (
            <Image src={feat.data.cover} alt="" widths={[640, 960, 1280]} sizes="(min-width: 1024px) 680px, 100vw" loading="eager" />
          ) : (
            <span class="lead__glyph">{featCard.glyph}</span>
          )}
        </span>
        <span class="lead__cap">图 · {featCard.coverAlt || featCard.title}</span>
      </a>
      <div class="lead__body rise" style="--i:1">
        <p class="kicker">头条 · 最新一篇</p>
        <h2 id="lead-title" class="lead__title display"><a href={postUrl(featCard.slug)} style={`view-transition-name: t-${featCard.slug}`}>{featCard.title}</a></h2>
        <p class="lead__desc">{featCard.description}</p>
        <p class="lead__meta">
          <time datetime={featCard.iso}>{featCard.date}</time><span>{featCard.words.toLocaleString('zh-CN')} 字</span><span>约 {featCard.minutes} 分钟</span>
        </p>
        <p class="lead__tags">{featCard.tags.map((t, i) => <a class="tag" href={tagUrl(featCard.tagSlugs[i])}>{t}</a>)}</p>
        <a class="link-arrow lead__more" href={postUrl(featCard.slug)}>读全文 <Icon name="right" size={16} /></a>
      </div>
    </section>
  )}

  <div class="cols wrap">
    <section class="recent" aria-labelledby="recent-title">
      <header class="sec rise">
        <h2 id="recent-title" class="display">往期</h2>
        <a class="link-arrow" href={url('/blog/')}>全部 {posts.length} 篇 <Icon name="right" size={15} /></a>
      </header>
      <ol class="rows">
        {recent.map((p, i) => <PostRow p={p} index={i + 1} />)}
      </ol>
    </section>

    <aside class="side" aria-label="专栏与标签">
      {series.map((s) => (
        <div class="idx rise">
          <p class="kicker">专栏</p>
          <h3 class="display">{s.name}</h3>
          <ol>
            {s.list.map((c) => (
              <li><a href={postUrl(c.slug)}><span class="idx__n mono">{String(c.series!.order).padStart(2, '0')}</span><span>{c.title}</span></a></li>
            ))}
          </ol>
        </div>
      ))}
      <div class="side__tags rise" style="--i:1">
        <p class="kicker">标签</p>
        <ul>
          {tags.map((t) => (
            <li><a class="tag" href={tagUrl(t.slug)}>{t.name}<span class="side__n mono">{tagCount(t.name)}</span></a></li>
          ))}
        </ul>
        <a class="link-arrow" href={url('/archive/')}>按时间翻归档 <Icon name="right" size={15} /></a>
      </div>
    </aside>
  </div>

  <Preview />
</Base>

<style>
  /* ---------- 报头 ---------- */
  .mast {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 380px);
    column-gap: clamp(28px, 5vw, 72px);
    padding-top: clamp(8px, 2vw, 24px);
  }
  .dateline {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 9px 0;
    border-top: 2px solid var(--ink);
    border-bottom: 1px solid var(--ink);
    font-size: 13px;
    color: var(--ink-2);
  }
  .dateline b {
    color: var(--ink);
    font: 600 13px var(--f-mono);
  }
  .mast__title {
    margin: clamp(26px, 5vw, 60px) 0 clamp(20px, 3vw, 36px);
    font-size: clamp(56px, 10.5vw, 156px);
    line-height: 0.98;
    letter-spacing: -0.045em;
    font-weight: 700;
  }
  .mast__title > span {
    display: block;
    white-space: nowrap;
  }
  /* 第二行错位缩进，打破居中对称 */
  .mast__l2 {
    padding-left: 0.9em;
  }
  .mast__ink {
    position: relative;
    color: var(--red);
  }
  .scribble {
    position: absolute;
    left: -3%;
    bottom: -0.08em;
    width: 106%;
    height: 0.2em;
    overflow: visible;
  }
  .scribble path {
    fill: none;
    stroke: var(--ink);
    stroke-width: 4;
    stroke-linecap: round;
    stroke-dasharray: 340;
    stroke-dashoffset: 340;
    animation: draw 1.1s 0.7s var(--ease) forwards;
  }
  @keyframes draw {
    to { stroke-dashoffset: 0; }
  }
  .mast__aside {
    align-self: end;
    margin-bottom: clamp(24px, 3.5vw, 44px);
    padding-left: 20px;
    border-left: 1px solid var(--rule-2);
  }
  .mast__lead {
    font-size: 16px;
    line-height: 1.9;
    color: var(--ink-2);
  }
  .mast__lead .marker {
    color: var(--ink);
  }
  .mast__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 26px;
  }
  .mast__keys {
    display: inline-flex;
    gap: 3px;
    margin-left: 2px;
  }
  @media (hover: none) {
    .mast__keys { display: none; }
  }
  .mast__keys .key {
    --h: 22px;
    font-size: 11px;
  }

  /* ---------- 头条 ---------- */
  .lead {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
    padding-top: clamp(28px, 4vw, 44px);
    border-top: 1px solid var(--ink);
  }
  .lead__frame {
    display: block;
    padding: 10px;
    background: var(--sheet);
    border: 1px solid var(--rule-2);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .lead__frame :global(img) {
    width: 100%;
    aspect-ratio: 1024 / 537;
    object-fit: contain;
    background: #fbf9f4;
  }
  .lead__glyph {
    display: grid;
    place-items: center;
    aspect-ratio: 1024 / 537;
    background: var(--paper-2);
    font: 700 120px/1 var(--f-display);
  }
  .lead__fig:hover .lead__frame {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--ink);
  }
  .lead__cap {
    display: block;
    margin-top: 10px;
    font-size: 13px;
    color: var(--ink-3);
  }
  .lead__title {
    margin: 12px 0 16px;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }
  .lead__title a {
    background: linear-gradient(var(--hi-soft), var(--hi-soft)) 0 88% / 0 0.4em no-repeat;
    transition: background-size 0.5s var(--ease);
  }
  .lead__title a:hover {
    background-size: 100% 0.4em;
  }
  .lead__desc {
    font-size: 16.5px;
    line-height: 1.85;
    color: var(--ink-2);
  }
  /* 首字下沉，像报纸头条 */
  .lead__desc::first-letter {
    float: left;
    margin: 6px 8px 0 0;
    font: 700 52px/0.9 var(--f-display);
    color: var(--red);
  }
  .lead__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 18px;
    padding-top: 12px;
    border-top: 1px dashed var(--rule-2);
    font: 12.5px var(--f-mono);
    color: var(--ink-3);
  }
  .lead__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .lead__more {
    margin-top: 22px;
  }

  /* ---------- 往期 + 侧栏 ---------- */
  .cols {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(28px, 5vw, 72px);
    margin-top: clamp(56px, 8vw, 104px);
  }
  .sec {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--ink);
  }
  .sec h2 {
    font-size: clamp(30px, 3.2vw, 40px);
  }
  .sec a {
    font-size: 14px;
  }
  .rows {
    padding: 0;
  }
  .rows :global(.row:first-child) {
    border-top: 0;
  }

  .side {
    display: grid;
    align-content: start;
    gap: 36px;
    padding-top: 8px;
  }
  /* 专栏：一张横线索引卡，左侧红色装订线 */
  .idx {
    position: relative;
    padding: 18px 18px 14px 30px;
    background:
      linear-gradient(90deg, transparent 17px, color-mix(in srgb, var(--red) 55%, transparent) 17px 18px, transparent 18px),
      var(--sheet);
    border: 1px solid var(--rule-2);
    rotate: 0.6deg;
    box-shadow: 3px 3px 0 var(--paper-2);
  }
  .idx h3 {
    margin: 4px 0 8px;
    font-size: 22px;
  }
  .idx ol {
    list-style: none;
    padding: 0;
  }
  .idx li + li {
    border-top: 1px solid var(--rule);
  }
  .idx a {
    display: grid;
    grid-template-columns: 26px 1fr;
    gap: 8px;
    padding: 9px 0;
    font-size: 14.5px;
    line-height: 1.5;
  }
  .idx a:hover span:last-child {
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-underline-offset: 3px;
  }
  .idx__n {
    color: var(--red-ink);
    font-size: 12px;
    padding-top: 2px;
  }
  .side__tags ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px 8px;
    margin: 14px 0 20px;
  }
  .side__tags .tag {
    height: 30px;
    font-size: 13.5px;
    gap: 8px;
  }
  .side__n {
    font-size: 11px;
    color: var(--ink-3);
  }
  .side__tags .link-arrow {
    font-size: 14px;
  }

  @media (max-width: 980px) {
    .mast {
      grid-template-columns: 1fr;
    }
    .mast__aside {
      max-width: 520px;
      margin-left: auto;
    }
    .cols {
      grid-template-columns: 1fr;
    }
    .side {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }
  }
  @media (max-width: 760px) {
    .dateline__mid {
      display: none;
    }
    .lead {
      grid-template-columns: 1fr;
    }
    .mast__aside {
      margin-left: 0;
    }
  }
  @media (max-width: 420px) {
    .mast__title {
      font-size: clamp(48px, 15vw, 60px);
    }
    .dateline {
      font-size: 12px;
    }
  }
</style>
