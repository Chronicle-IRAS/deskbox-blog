---

import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import PostRow from '../../components/PostRow.astro';
import Preview from '../../components/Preview.astro';
import Icon from '../../components/Icon.astro';
import { getPosts } from '../../lib/posts';
import { cardData } from '../../lib/meta';
import { getTags } from '../../config';
import { url, tagUrl } from '../../lib/url';
const tags = getTags();
const t = tags.find((tag) => tag.slug === Astro.params.tag);
if (!t) return new Response('标签不存在', { status: 404 });
const posts = (await getPosts()).filter((p) => (p.data.tags as string[]).includes(t.name));
const cards = await Promise.all(posts.map(cardData));
---
<Base title={`#${t.name}`} description={`${t.name}：${t.description}。DeskBox 中带有该标签的文章。`}>
  <PageHead eyebrow={`标签 · /${t.slug}`} title={`#${t.name}`} count={cards.length} lead={t.description}>
    <nav class="others rise" style="--i:3" aria-label="其他标签">
      <a class="tag tag--back" href={url('/tags/')}>← 全部标签</a>
      {tags.filter((x) => x.slug !== t.slug).map((x) => <a class="tag" href={tagUrl(x.slug)}>{x.name}</a>)}
    </nav>
  </PageHead>
  <div class="wrap">
    {cards.length ? <ol class="rows">{cards.map((p, i) => <PostRow p={p} index={i} />)}</ol>
      : <p class="empty muted">这个标签下还没有文章。<a href={url('/blog/')}>看看全部文章 <Icon name="right" size={14} /></a></p>}
  </div>
  <Preview />
</Base>
<style>
  .others {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 8px;
    margin-top: 24px;
  }
  .rows {
    padding: 0;
  }
  .empty {
    padding: 60px 0;
    text-align: center;
  }
  .empty a {
    color: var(--red-ink);
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }
</style>
