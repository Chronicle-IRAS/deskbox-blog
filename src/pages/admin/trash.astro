---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession } from '../../server/auth';
import { searchAdminPosts } from '../../server/posts';

const session = getSession(Astro);

if (!session) {
  return Astro.redirect('/login/');
}

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const pageParam = Number(Astro.url.searchParams.get('page') ?? 1);
const page = Number.isInteger(pageParam) && pageParam > 0 ? pageParam : 1;
const result = searchAdminPosts({ status: 'trash', q, page, pageSize: 20 });

const pageHref = (value: number) => {
  const params = new URLSearchParams();
  if (q) params.set('q', q);
  if (value > 1) params.set('page', String(value));
  return `/admin/trash/${params.toString() ? `?${params}` : ''}`;
};
---

<AdminLayout title="回收站" csrfToken={session.csrfToken}>
  <div class="admin-page-head">
    <div>
      <h1>回收站</h1>
      <p>{result.total} 篇已删除文章</p>
    </div>
    <a href="/admin/">返回文章</a>
  </div>

  <form class="trash-search" method="get" action="/admin/trash/" role="search">
    <label>
      <span class="sr-only">搜索回收站</span>
      <input name="q" type="search" value={q} placeholder="搜索已删除文章" />
    </label>
    <button type="submit">搜索</button>
    {q && <a href="/admin/trash/">清除</a>}
  </form>

  {result.posts.length === 0 ? (
    <p class="trash-empty">{q ? '没有匹配的文章。' : '回收站是空的。'}</p>
  ) : (
    <ul class="trash-list">
      {result.posts.map((post) => (
        <li>
          <div>
            <strong>{post.title}</strong>
            <p>
              <span>{post.slug}</span>
              <span>删除于 {post.updatedAt.slice(0, 10)}</span>
            </p>
          </div>
          <button
            type="button"
            data-restore-id={post.id}
            data-restore-version={post.version}
          >
            恢复为草稿
          </button>
        </li>
      ))}
    </ul>
  )}

  <p id="trash-status" class="trash-status" aria-live="polite"></p>

  {result.totalPages > 1 && (
    <nav class="trash-pagination" aria-label="回收站分页">
      {result.page > 1 ? (
        <a href={pageHref(result.page - 1)}>上一页</a>
      ) : (
        <span aria-disabled="true">上一页</span>
      )}
      <span>第 {result.page} / {result.totalPages} 页</span>
      {result.page < result.totalPages ? (
        <a href={pageHref(result.page + 1)}>下一页</a>
      ) : (
        <span aria-disabled="true">下一页</span>
      )}
    </nav>
  )}
</AdminLayout>

<style>
  .admin-page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-end: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .admin-page-head h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
  }

  .admin-page-head p {
    margin: var(--space-1) 0 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .admin-page-head a {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .trash-search {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-block: var(--space-4);
  }

  .trash-search input {
    min-height: 44px;
    width: min(22rem, 60vw);
    padding: 0 var(--space-3);
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font: inherit;
  }

  .trash-search button {
    min-height: 44px;
    padding: 0 var(--space-4);
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font: inherit;
    cursor: pointer;
  }

  .trash-search a {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .trash-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .trash-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .trash-list strong {
    font-size: var(--text-lg);
  }

  .trash-list p {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: var(--space-1) 0 0;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .trash-list button {
    min-height: 44px;
    padding: 0 var(--space-4);
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font: inherit;
    cursor: pointer;
  }

  .trash-list button:hover {
    background: var(--surface-muted);
  }

  .trash-list button:disabled {
    opacity: 0.5;
    cursor: wait;
  }

  .trash-empty {
    margin-top: var(--space-6);
    padding: var(--space-7);
    color: var(--fg-muted);
    text-align: center;
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
  }

  .trash-status {
    min-height: 1.5em;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .trash-pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-block-start: var(--space-6);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .trash-pagination a {
    color: var(--fg-muted);
  }

  @media (max-width: 639px) {
    .trash-search input {
      width: 100%;
    }

    .trash-search {
      width: 100%;
    }
  }
</style>
