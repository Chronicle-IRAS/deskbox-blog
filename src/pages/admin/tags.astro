---
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession } from '../../server/auth';
import { listTags } from '../../server/posts';

const session = getSession(Astro);

if (!session) {
  return Astro.redirect('/login/');
}

const tags = listTags();
const error = Astro.url.searchParams.get('error');
---

<AdminLayout title="标签" csrfToken={session.csrfToken}>
  <div class="admin-page-head">
    <div>
      <h1>标签</h1>
      <p>{tags.length} 个标签</p>
    </div>
    <a href="/admin/">返回文章</a>
  </div>

  {error && <p class="admin-error" role="alert">{error}</p>}

  <form class="tag-form" method="post" action="/api/admin/tags/">
    <input type="hidden" name="csrf" value={session.csrfToken} />

    <label>
      <span>名称</span>
      <input name="name" required maxlength="20" placeholder="例如：数据库" />
    </label>
    <label>
      <span>slug</span>
      <input
        name="slug"
        required
        maxlength="40"
        pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
        placeholder="database"
      />
    </label>
    <label>
      <span>说明（可选）</span>
      <input name="description" maxlength="80" />
    </label>
    <button type="submit">添加标签</button>
  </form>

  <ul class="tag-admin-list">
    {tags.map((tag) => (
      <li>
        <strong>{tag.name}</strong>
        <code>{tag.slug}</code>
        <span>{tag.count} 篇</span>
        {tag.description && <span>{tag.description}</span>}
      </li>
    ))}
  </ul>
</AdminLayout>

<style>
  .admin-page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-end: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .admin-page-head h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h1);
    line-height: var(--leading-h1);
  }

  .admin-page-head p {
    margin: var(--space-1) 0 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .admin-page-head a {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .admin-error {
    margin: var(--space-4) 0;
    padding: var(--space-3) var(--space-4);
    color: var(--error);
    background: var(--surface-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .tag-form {
    display: grid;
    grid-template-columns: 1fr 1fr 2fr auto;
    gap: var(--space-3);
    align-items: end;
    margin-block: var(--space-5);
    padding: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .tag-form label {
    display: grid;
    gap: var(--space-2);
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .tag-form input {
    min-height: 44px;
    padding: 0 var(--space-3);
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    font: inherit;
  }

  .tag-form input:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .tag-form button {
    min-height: 44px;
    padding: 0 var(--space-5);
    color: var(--on-accent);
    background: var(--accent-solid);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .tag-form button:hover {
    background: var(--accent-solid-hover);
  }

  .tag-admin-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag-admin-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
    font-size: var(--text-sm);
  }

  .tag-admin-list code,
  .tag-admin-list span {
    color: var(--fg-muted);
  }

  @media (max-width: 767px) {
    .tag-form {
      grid-template-columns: 1fr;
    }
  }
</style>
