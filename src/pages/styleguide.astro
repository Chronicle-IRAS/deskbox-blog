---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageTitle } from '../data/site';
import '../styles/prose.css';
---

<BaseLayout
  title={pageTitle('Styleguide')}
  description="DeskBox 视觉设计系统与 P0/P1 组件规范参考页"
  noindex
>
  <div class="sg">
    <header class="sg__header">
      <h1>Styleguide</h1>
      <p>
        Swiss Editorial 视觉系统参考（P0 核心组件 + P1 阅读/分发扩展规范）。此页设置
        <code>noindex</code>，不进入主导航。
      </p>
    </header>

    <section class="sg__section" aria-labelledby="sg-color">
      <h2 id="sg-color">01 · 颜色与对比度（WCAG 2.2 AA）</h2>
      <div class="sg__swatches">
        <div class="sg__swatch sg__swatch--bg">
          <strong>--bg</strong>
          <span>#FAFAFA / #09090B</span>
        </div>
        <div class="sg__swatch sg__swatch--surface">
          <strong>--surface</strong>
          <span>#FFFFFF / #141416</span>
        </div>
        <div class="sg__swatch sg__swatch--muted">
          <strong>--surface-muted</strong>
          <span>#F4F4F5 / #1C1C1F</span>
        </div>
        <div class="sg__swatch sg__swatch--fg">
          <strong>--fg (19.06:1)</strong>
          <span>#09090B / #FAFAFA</span>
        </div>
        <div class="sg__swatch sg__swatch--fg-muted">
          <strong>--fg-muted (7.41:1)</strong>
          <span>#52525B / #A1A1AA</span>
        </div>
        <div class="sg__swatch sg__swatch--accent">
          <strong>--accent (5.78:1)</strong>
          <span>#BE185D / #F9A8D4</span>
        </div>
        <div class="sg__swatch sg__swatch--solid">
          <strong>--accent-solid (5.02:1)</strong>
          <span>#EC4899 + #18181B</span>
        </div>
      </div>
    </section>

    <section class="sg__section" aria-labelledby="sg-type">
      <h2 id="sg-type">02 · 字体与字阶</h2>
      <div class="sg__type-stack">
        <p class="sg__display">DeskBox · 瑞士编辑风</p>
        <p class="sg__h1">文章主标题 H1 · Libre Bodoni &amp; 宋体</p>
        <p class="sg__h2">章节标题 H2 · 1.75rem / 1.2</p>
        <p class="sg__h3">小节标题 H3 · 1.375rem / 1.35</p>
        <p class="sg__lead">导语与卡片标题 · 1.25rem / 1.5</p>
        <p class="sg__body">
          正文 16–17px / 1.85（单列行宽 42rem，约 40 个中文字符）。文字是页面唯一的主角，导航、标签、元信息退居次席。
        </p>
        <p class="sg__small">辅助元信息 · 0.875rem (14px) / 1.6 · 2026.10.18 · 约 8 分钟</p>
        <p class="sg__caption">说明与代码语言标签 · 0.75rem (12px) / 1.5 · monospace</p>
      </div>
    </section>

    <section class="sg__section" aria-labelledby="sg-space">
      <h2 id="sg-space">03 · 间距节奏（8px 基准）</h2>
      <div class="sg__spacing">
        <span class="sg__space sg__space--1">4px (--space-1)</span>
        <span class="sg__space sg__space--2">8px (--space-2)</span>
        <span class="sg__space sg__space--3">12px (--space-3)</span>
        <span class="sg__space sg__space--4">16px (--space-4)</span>
        <span class="sg__space sg__space--5">24px (--space-5)</span>
        <span class="sg__space sg__space--6">32px (--space-6)</span>
        <span class="sg__space sg__space--7">48px (--space-7)</span>
        <span class="sg__space sg__space--8">64px (--space-8)</span>
        <span class="sg__space sg__space--9">96px (--space-9)</span>
      </div>
    </section>

    <section class="sg__section" aria-labelledby="sg-components">
      <h2 id="sg-components">04 · P0 基础组件与状态</h2>

      <div class="sg__row">
        <button class="sg__button sg__button--primary" type="button">
          主按钮（44px）
        </button>
        <button class="sg__button" type="button">次按钮（1px 强边框）</button>
        <button class="sg__button sg__button--ghost" type="button">幽灵按钮</button>
        <button class="sg__button" type="button" disabled>禁用状态</button>
      </div>

      <div class="sg__row">
        <span class="sg__tag">#前端</span>
        <span class="sg__tag">#工程实践</span>
        <a class="sg__tag sg__tag--link" href="/blog/">#可点击标签（P1 链接态）</a>
      </div>

      <div class="sg__code">
        <span class="sg__code-lang">ts</span>
        <pre tabindex="0" aria-label="示例Ts代码"><code>const posts = await getPublishedPosts();</code></pre>
      </div>

      <div class="sg__prose prose">
        <h3>正文排版与宽表</h3>
        <p>
          这是一段正文示例，用于检查行高、段落间距与链接
          <a href="/blog/">文章列表</a> 的下划线过渡效果，以及行内代码
          <code>getCollection('blog')</code> 的视觉边界。
        </p>
        <blockquote>引用块使用左侧 2px 信号色边框与次级字色，不添加大面积背景。</blockquote>
      </div>

      <div class="sg__states">
        <p class="sg__empty">这里还没有内容。（1px 虚线空状态）</p>
      </div>
    </section>

    <section class="sg__section" aria-labelledby="sg-p1">
      <h2 id="sg-p1">05 · P1 阅读与分发视觉规范</h2>

      <div class="sg__p1-block">
        <h3>分页控件（Pagination）</h3>
        <nav class="pagination" aria-label="分页示例">
          <span class="pagination__arrow" aria-disabled="true">上一页</span>
          <ol class="pagination__pages">
            <li><span class="pagination__page" aria-current="page">1</span></li>
            <li><a class="pagination__page" href="#sg-p1">2</a></li>
            <li><a class="pagination__page" href="#sg-p1">3</a></li>
          </ol>
          <a class="pagination__arrow" href="#sg-p1">下一页</a>
        </nav>
      </div>

      <div class="sg__p1-block">
        <h3>标签索引行（Tag Index）</h3>
        <ul class="tag-list">
          <li class="tag-list__item">
            <a class="tag-list__name" href="#sg-p1">#前端</a>
            <span class="tag-list__count">4 篇</span>
            <p class="tag-list__description">浏览器、框架与工程化实践记录。</p>
          </li>
          <li class="tag-list__item">
            <a class="tag-list__name" href="#sg-p1">#阅读</a>
            <span class="tag-list__count">5 篇</span>
            <p class="tag-list__description">书与长文笔记。</p>
          </li>
        </ul>
      </div>

      <div class="sg__p1-block">
        <h3>按年归档（Archive）</h3>
        <div class="archive__year">
          <h4>2026</h4>
          <ul class="archive__list">
            <li class="archive__item">
              <time datetime="2026-10-18">2026.10.18</time>
              <a class="archive__title" href="/blog/astro-content-collections/">
                用 Astro 内容集合管理博客文章
              </a>
              <span class="archive__tags">#前端 · #工程实践</span>
            </li>
          </ul>
        </div>
      </div>

      <div class="sg__p1-block">
        <h3>搜索状态与命中高亮（Search）</h3>
        <div class="sg__search-demo">
          <label class="sg__search-label" for="sg-search-input">搜索关键词</label>
          <div class="sg__search-row">
            <input
              id="sg-search-input"
              class="sg__search-input"
              type="search"
              value="内容集合"
              readonly
            />
            <button class="sg__button sg__button--primary" type="button">搜索</button>
          </div>
          <div class="sg__search-result">
            <a href="/blog/astro-content-collections/">用 Astro 内容集合管理博客文章</a>
            <p>
              ……把散落在目录里的 Markdown 变成有类型、可校验的数据。<mark>内容集合</mark>把检查提前到构建阶段……
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .sg {
    max-width: var(--container);
    margin-inline: auto;
    padding-block-start: clamp(2.5rem, 6vw, 4.5rem);
    padding-inline: var(--gutter);
  }

  .sg__header {
    padding-block-end: var(--space-5);
    border-bottom: 1px solid var(--border);
  }

  .sg__header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-h1);
    line-height: 1.1;
  }

  .sg__header p {
    margin: var(--space-3) 0 0;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .sg__section {
    padding-block: var(--space-7);
    border-bottom: 1px solid var(--border);
  }

  .sg__section h2 {
    margin: 0 0 var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-h2);
  }

  .sg__swatches {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(156px, 1fr));
    gap: var(--space-3);
  }

  .sg__swatch {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 96px;
    padding: var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .sg__swatch--bg {
    background: var(--bg);
    color: var(--fg);
  }

  .sg__swatch--surface {
    background: var(--surface);
    color: var(--fg);
  }

  .sg__swatch--muted {
    background: var(--surface-muted);
    color: var(--fg);
  }

  .sg__swatch--fg {
    background: var(--fg);
    color: var(--bg);
  }

  .sg__swatch--fg-muted {
    background: var(--bg);
    color: var(--fg-muted);
  }

  .sg__swatch--accent {
    background: var(--accent);
    color: var(--bg);
  }

  .sg__swatch--solid {
    background: var(--accent-solid);
    color: var(--on-accent);
  }

  .sg__type-stack > * + * {
    margin-top: var(--space-3);
  }

  .sg__display,
  .sg__h1,
  .sg__h2,
  .sg__h3 {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.15;
  }

  .sg__display {
    font-size: var(--text-display);
    letter-spacing: -0.02em;
  }

  .sg__h1 {
    font-size: var(--text-h1);
  }

  .sg__h2 {
    font-size: var(--text-h2);
  }

  .sg__h3 {
    font-size: var(--text-h3);
  }

  .sg__lead {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .sg__body {
    max-width: var(--measure);
  }

  .sg__small {
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .sg__caption {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .sg__spacing {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .sg__space {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 24px;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .sg__space::before {
    content: "";
    display: block;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
  }

  .sg__space--1::before { width: var(--space-1); }
  .sg__space--2::before { width: var(--space-2); }
  .sg__space--3::before { width: var(--space-3); }
  .sg__space--4::before { width: var(--space-4); }
  .sg__space--5::before { width: var(--space-5); }
  .sg__space--6::before { width: var(--space-6); }
  .sg__space--7::before { width: var(--space-7); }
  .sg__space--8::before { width: var(--space-8); }
  .sg__space--9::before { width: var(--space-9); }

  .sg__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-block-end: var(--space-5);
  }

  .sg__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--space-5);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--fg);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .sg__button:hover:not(:disabled) {
    background: var(--surface-muted);
  }

  .sg__button:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .sg__button--primary {
    border-color: var(--accent-solid);
    background: var(--accent-solid);
    color: var(--on-accent);
  }

  .sg__button--primary:hover:not(:disabled) {
    border-color: var(--accent-solid-hover);
    background: var(--accent-solid-hover);
  }

  .sg__button--ghost {
    border-color: transparent;
    color: var(--fg-muted);
  }

  .sg__tag {
    display: inline-flex;
    align-items: center;
    min-height: 28px;
    padding: 2px 10px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--fg-muted);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .sg__tag--link:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }

  .sg__code {
    position: relative;
    margin-block-end: var(--space-6);
    padding: var(--space-4);
    padding-block-start: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--surface-muted);
    overflow-x: auto;
  }

  .sg__code-lang {
    position: absolute;
    inset-block-start: var(--space-2);
    inset-inline-start: var(--space-3);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .sg__code pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .sg__prose {
    padding: var(--space-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .sg__states {
    margin-top: var(--space-5);
  }

  .sg__empty {
    padding: var(--space-6) var(--space-5);
    border: 1px dashed var(--border);
    border-radius: var(--radius-md);
    color: var(--fg-muted);
    text-align: center;
  }

  .sg__p1-block {
    margin-top: var(--space-6);
  }

  .sg__p1-block h3 {
    margin: 0 0 var(--space-3);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .pagination__pages {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pagination__arrow,
  .pagination__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 var(--space-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--fg-muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .pagination__page[aria-current="page"] {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--surface);
  }

  .pagination__arrow[aria-disabled="true"] {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .tag-list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .tag-list__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .tag-list__name {
    color: var(--fg);
    font-weight: 600;
    text-decoration: none;
  }

  .tag-list__count {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .tag-list__description {
    grid-column: 1 / -1;
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .archive__year h4 {
    margin: 0 0 var(--space-2);
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .archive__list {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .archive__item {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    gap: var(--space-4);
    align-items: baseline;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border);
  }

  .archive__item time {
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .archive__title {
    color: var(--fg);
    text-decoration: none;
  }

  .archive__tags {
    color: var(--fg-muted);
    font-size: var(--text-xs);
  }

  .sg__search-demo {
    max-width: var(--measure);
  }

  .sg__search-label {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .sg__search-row {
    display: flex;
    gap: var(--space-2);
  }

  .sg__search-input {
    flex: 1;
    min-width: 0;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--fg);
  }

  .sg__search-result {
    margin-top: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border);
  }

  .sg__search-result a {
    color: var(--fg);
    font-weight: 600;
    text-decoration: none;
  }

  .sg__search-result p {
    margin-top: var(--space-2);
    color: var(--fg-muted);
    font-size: var(--text-sm);
  }

  .sg__search-result mark {
    background: var(--selection-bg);
    color: var(--selection-fg);
    padding-inline: 2px;
    border-radius: 2px;
  }

  @media (max-width: 639px) {
    .archive__item {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
