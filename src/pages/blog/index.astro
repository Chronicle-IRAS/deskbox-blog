---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogIndexView from '../../components/BlogIndexView.astro';
import { pageTitle, site } from '../../data/site';
import { getPublishedPosts, toPostSummary } from '../../lib/posts';

const PAGE_SIZE = 10;
const allPosts = await getPublishedPosts();
const posts = allPosts.slice(0, PAGE_SIZE).map(toPostSummary);
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
---

<BaseLayout
  title={pageTitle('文章')}
  description={site.description}
  activeNav="blog"
>
  <BlogIndexView
    posts={posts}
    total={allPosts.length}
    page={1}
    totalPages={totalPages}
  />
</BaseLayout>
