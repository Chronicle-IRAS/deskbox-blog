---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { url } from '../lib/url';
---
<Base title="404 · 这页不在桌上" description="页面不存在。" noindex>
  <section class="nf wrap">
    <p class="kicker nf__k">错误 · 404</p>
    <div class="nf__row">
      <h1 class="nf__code display" aria-label="404">
        <span aria-hidden="true">4</span><span class="nf__o" aria-hidden="true">0<svg viewBox="0 0 200 200" aria-hidden="true"><path d="M100 18c46 0 82 35 82 80 0 47-36 84-84 84-45 0-80-36-80-82 0-44 36-80 80-81" /><path d="M150 40c12 10 20 22 24 38" /></svg></span><span aria-hidden="true">4</span>
      </h1>
      <div class="nf__note">
        <p class="nf__t display">这页不在桌上。</p>
        <p class="nf__d muted">可能被收进了抽屉，或者链接抄错了一位。桌上只留下一圈咖啡渍。</p>
        <div class="nf__cta">
          <a class="btn" href={url('/')}>回到首页 <Icon name="right" /></a>
          <button class="btn btn--paper" type="button" data-search-open><Icon name="search" /> 搜索文章</button>
        </div>
      </div>
    </div>
  </section>
</Base>
<style>
  .nf {
    padding-top: clamp(16px, 4vw, 40px);
  }
  .nf__k {
    padding-bottom: 10px;
    border-bottom: 2px solid var(--ink);
  }
  .nf__row {
    display: grid;
    grid-template-columns: auto minmax(0, 420px);
    align-items: end;
    gap: clamp(24px, 5vw, 72px);
    margin-top: clamp(24px, 4vw, 48px);
  }
  .nf__code {
    font-size: clamp(130px, 24vw, 320px);
    line-height: 0.82;
    letter-spacing: -0.06em;
    font-weight: 700;
  }
  .nf__o {
    position: relative;
    display: inline-block;
    color: transparent;
  }
  /* 0 是一圈咖啡渍 */
  .nf__o svg {
    position: absolute;
    left: -6%;
    top: 4%;
    width: 112%;
    overflow: visible;
    rotate: -12deg;
  }
  .nf__o path {
    fill: none;
    stroke: #8a5a2b;
    stroke-width: 12;
    stroke-linecap: round;
    opacity: 0.55;
  }
  .nf__o path + path {
    stroke-width: 5;
    opacity: 0.35;
  }
  .nf__t {
    font-size: clamp(28px, 3vw, 40px);
  }
  .nf__d {
    margin-top: 10px;
  }
  .nf__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 28px;
  }
  @media (max-width: 760px) {
    .nf__row {
      grid-template-columns: 1fr;
    }
  }
</style>
