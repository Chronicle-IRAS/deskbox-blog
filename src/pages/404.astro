---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageTitle } from '../data/site';
---

<BaseLayout
  title={pageTitle('404')}
  description="页面不存在"
  noindex
>
  <section class="not-found">
    <p class="not-found__code" aria-hidden="true">404</p>
    <h1>这一页没有内容。</h1>
    <p class="not-found__text">链接可能已经失效，或者文章被移动了。</p>

    <div class="not-found__actions">
      <a class="not-found__action not-found__action--primary" href="/">
        返回首页
      </a>
      <a class="not-found__action" href="/blog/">浏览文章</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    margin-inline: auto;
    padding-block-start: clamp(3rem, 8vw, 6rem);
    padding-block-end: var(--space-6);
    padding-inline: var(--gutter);
  }

  .not-found__code {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 12vw, 6.5rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .not-found h1 {
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: 1.1;
    text-wrap: balance;
  }

  .not-found__text {
    max-width: 36ch;
    margin: var(--space-3) 0 0;
    color: var(--fg-muted);
    font-size: var(--text-base);
    line-height: var(--leading-base);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
    padding-block-start: var(--space-5);
    border-top: 1px solid var(--border);
  }

  .not-found__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 var(--space-5);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    color: var(--fg);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .not-found__action:hover {
    background: var(--surface-muted);
    border-color: var(--fg);
    color: var(--fg);
  }

  .not-found__action:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .not-found__action--primary {
    border-color: var(--accent-solid);
    background: var(--accent-solid);
    color: var(--on-accent);
  }

  .not-found__action--primary:hover {
    border-color: var(--accent-solid-hover);
    background: var(--accent-solid-hover);
    color: var(--on-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__action {
      transition: none;
    }
  }
</style>
